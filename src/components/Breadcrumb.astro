---
import { comBase } from '../lib/aulas';
const { aula } = Astro.props;
const items = [
  { label: 'Início', href: comBase('/') },
  { label: aula.data.materia, href: comBase(`/${aula.data.materiaSlug}`) },
  { label: `Semana ${aula.data.semana}`, href: comBase(`/${aula.data.materiaSlug}/${aula.data.bimestre}/semana-${aula.data.semana}`) },
  { label: aula.data.titulo },
];
---
<nav class="breadcrumbs" aria-label="Caminho da página">
  <ol>
    {items.map((item, index) => <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>}</li>)}
  </ol>
</nav>
