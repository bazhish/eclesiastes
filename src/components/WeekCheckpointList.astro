---
import { comBase } from '../lib/aulas';

const { materia, grupos } = Astro.props as {
  materia: string;
  grupos: Array<{ bimestre: number; semanas: Array<{ semana: number; tema: string; paths: string[] }> }>;
};
---
<div class="bimestre-sections">
  {grupos.map((grupo) => <section class="bimestre-section" aria-labelledby={`bimestre-${grupo.bimestre}`}>
    <h2 id={`bimestre-${grupo.bimestre}`}>{grupo.bimestre}º Bimestre</h2>
    <ol class="checkpoint-list">
      {grupo.semanas.map((semana) => <li class="checkpoint-item" data-week-checkpoint={JSON.stringify(semana.paths)} data-progress="0">
        <span class="checkpoint" aria-hidden="true"><span data-checkpoint-value></span></span>
        <a href={comBase(`/${materia}/${grupo.bimestre}/semana-${semana.semana}`)}>Semana {semana.semana} (S{semana.semana}) — {semana.tema}</a>
        <span class="sr-only" data-checkpoint-description>0% concluída: 0 de {semana.paths.length} páginas visitadas.</span>
      </li>)}
    </ol>
  </section>)}
</div>
