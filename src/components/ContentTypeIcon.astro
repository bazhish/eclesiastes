---
import type { ContentType } from '../lib/aulas';
const { tipo, label = true } = Astro.props as { tipo: ContentType; label?: boolean };
const names: Record<ContentType, string> = { pausa: 'Pause e Responda', roteiro: 'Material da aula', registro: 'Registro da aula', aula: 'Aula' };
const symbols: Record<ContentType, string> = { pausa: 'H5P', roteiro: 'PDF', registro: 'T', aula: 'A' };
---
<span class:list={['content-type', `content-type--${tipo}`]} title={names[tipo]}>
  <span class="content-type__icon" aria-hidden="true">{symbols[tipo]}</span>
  {label && <span>{names[tipo]}</span>}
</span>
