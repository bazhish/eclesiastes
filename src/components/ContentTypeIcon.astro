---
import type { ContentType } from '../lib/aulas';
const { tipo, label = true } = Astro.props as { tipo: ContentType; label?: boolean };
const names: Record<ContentType, string> = { pausa: 'Pause e Responda', roteiro: 'Material da aula', registro: 'Registro da aula', observacao: 'Observações', aula: 'Aula' };
const symbols: Record<ContentType, string> = { pausa: 'fa-cubes', roteiro: 'fa-file-pdf', registro: 'fa-file-signature', observacao: 'fa-circle-info', aula: 'fa-file-lines' };
---
<span class:list={['content-type', `content-type--${tipo}`]} title={names[tipo]}>
  <span class="content-type__icon" aria-hidden="true"><i class:list={['fa-solid', symbols[tipo]]}></i></span>
  {label && <span>{names[tipo]}</span>}
</span>
