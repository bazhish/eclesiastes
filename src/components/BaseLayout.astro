---
import '../styles/global.css';
import Sidebar from './Sidebar.astro';
import { comBase, todasAsAulas } from '../lib/aulas';

const {
  title = 'Eclesiastes',
  description = 'Disciplinas e aulas de Desenvolvimento de Sistemas.',
  currentPath = '',
  wide = false,
  showSidebar = false,
} = Astro.props;
const aulas = showSidebar ? await todasAsAulas() : [];
const pathParts = currentPath.split('/').filter(Boolean);
const currentMateria = pathParts[0] ?? '';
const currentBimestre = Number(pathParts[1]) || 3;
const canonical = Astro.url;
const socialImage = new URL(comBase('/og-eclesiastes.png'), Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={comBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={comBase('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={comBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={comBase('/site.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eclesiastes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('eclesiastes-theme');
        if (savedTheme) document.documentElement.dataset.theme = savedTheme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo principal</a>
    <header class="topbar">
      <a class="brand" href={comBase('/')} aria-label="Eclesiastes — Minhas disciplinas">
        <img class="brand-mark" src={comBase('/brand.svg')} alt="" width="42" height="42" />
        <span>Eclesiastes<small>Desenvolvimento de Sistemas</small></span>
      </a>
      <nav class="primary-nav" aria-label="Navegação principal"><a href={comBase('/')} aria-current={currentPath === '' ? 'page' : undefined}><span aria-hidden="true">▰</span> Minhas disciplinas</a></nav>
      <div class="topbar-actions">
        {showSidebar && <button class="drawer-toggle" type="button" data-nav-toggle aria-expanded="true" aria-controls="navegacao"><span aria-hidden="true">☰</span><span class="sr-only">Abrir ou fechar sumário da disciplina</span></button>}
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar entre tema claro e escuro">Tema</button>
      </div>
    </header>
    <div class:list={['app-layout', { 'app-layout--drawer': showSidebar, 'app-layout--wide': wide }]} data-layout data-sidebar-shell>
      {showSidebar && <Sidebar aulas={aulas} currentPath={currentPath} materiaAtual={currentMateria} bimestreAtual={currentBimestre} />}
      {showSidebar && <button class="drawer-backdrop" type="button" data-sidebar-backdrop aria-label="Fechar sumário da disciplina"></button>}
      <main id="conteudo" class="main-content"><slot /></main>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('eclesiastes-theme', next); } catch {}
      });

      const nav = document.querySelector<HTMLElement>('#navegacao');
      const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const layout = document.querySelector<HTMLElement>('[data-layout]');
      const backdrop = document.querySelector<HTMLButtonElement>('[data-sidebar-backdrop]');
      const close = document.querySelector<HTMLButtonElement>('[data-sidebar-close]');
      const setDrawer = (open: boolean) => {
        nav?.setAttribute('data-open', String(open));
        layout?.toggleAttribute('data-drawer-open', open);
        navToggle?.setAttribute('aria-expanded', String(open));
      };
      navToggle?.addEventListener('click', () => setDrawer(nav?.getAttribute('data-open') !== 'true'));
      backdrop?.addEventListener('click', () => setDrawer(false));
      close?.addEventListener('click', () => setDrawer(false));
      if (window.matchMedia('(max-width: 767px)').matches) setDrawer(false);
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setDrawer(false); });
    </script>
  </body>
</html>
