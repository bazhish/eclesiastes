---
import ContentTypeIcon from './ContentTypeIcon.astro';
const { index } = Astro.props as { quiz: unknown; index: string };
---
<section class="resource-detail" aria-labelledby={`quiz-${index}`}>
  <header><ContentTypeIcon tipo="pausa" label={false} /><h2 id={`quiz-${index}`}>Pause e Responda</h2></header>
  <div class="resource-detail__message">A resposta ainda não foi divulgada.</div>
</section>
