---
import AnswerBlock from './AnswerBlock.astro';
import ContentTypeIcon from './ContentTypeIcon.astro';
const { quiz, index } = Astro.props as { quiz: { pergunta: string; resposta: string; titulo?: string; conteudo?: string }; index: string };
const content = quiz.conteudo ?? quiz.resposta;
---
<section class="resource-detail" aria-labelledby={`quiz-${index}`}>
  <header><ContentTypeIcon tipo="pausa" label={false} /><h2 id={`quiz-${index}`}>Pause e Responda</h2></header>
  <div class="resource-detail__body">
    <AnswerBlock title={quiz.titulo ?? quiz.pergunta} content={content} id={`quiz-${index}-resposta`} />
  </div>
</section>
