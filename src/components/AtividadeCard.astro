---
import CopyButton from './CopyButton.astro';
const { atividade, id } = Astro.props;
---
<section class="activity-card" aria-labelledby={`${id}-title`}>
  <p class="eyebrow">Atividade prática</p>
  <h2 id={`${id}-title`}>{atividade.tipo === 'resposta' ? 'Resposta de referência' : 'Roteiro de execução'}</h2>
  <div id={`${id}-response`} class="response">{atividade.resposta}</div>
  <div class="card-actions"><CopyButton targetId={`${id}-response`} /></div>
  <details class="source-details">
    <summary>Ver roteiro original</summary>
    <div id={`${id}-source`} class="source-text">{atividade.enunciado}</div>
    <div class="card-actions"><CopyButton targetId={`${id}-source`} label="Copiar roteiro" /></div>
  </details>
  <p class="source-note">Fonte: <code>{atividade.fonte}</code></p>
</section>
