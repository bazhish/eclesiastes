---
import BaseLayout from '../components/BaseLayout.astro';
import SubjectIllustration from '../components/SubjectIllustration.astro';
import { comBase, todasAsAulas } from '../lib/aulas';

const aulas = await todasAsAulas();
const materias = Array.from(new Map(aulas.map((aula) => [aula.data.materiaSlug, aula.data.materia])).entries()).map(([slug, nome]) => ({
  slug,
  nome,
  total: aulas.filter((aula) => aula.data.materiaSlug === slug).length,
}));
---
<BaseLayout title="Eclesiastes · Desenvolvimento de Sistemas" wide>
  <p class="eyebrow">Conhecimento em rede</p>
  <h1>Eclesiastes</h1>
  <p class="lede">Estrutura organizada por matéria, semana e aula, pronta para receber novos conteúdos de Desenvolvimento de Sistemas.</p>

  <section class="subject-grid" data-subject-grid aria-label="Matérias">
    {materias.map((materia) => <article class="subject-card" data-subject-card data-subject-slug={materia.slug} data-subject-name={materia.nome}>
      <div class="subject-card__art"><SubjectIllustration subject={materia.slug} /><button class="favorite-toggle" type="button" data-favorite-toggle aria-pressed="false" title="Adicionar aos favoritos"><span aria-hidden="true" data-favorite-icon>☆</span><span class="sr-only" data-favorite-label>Adicionar aos favoritos</span></button><a class="subject-access" href={comBase(`/${materia.slug}`)}>Acessar <span aria-hidden="true">→</span></a></div>
      <div class="subject-card__body"><p>Matéria</p><h2>{materia.nome}</h2><span>{materia.total} conteúdos disponíveis</span></div>
    </article>)}
  </section>
</BaseLayout>
