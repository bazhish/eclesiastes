---
import BaseLayout from '../components/BaseLayout.astro';
import { comBase, todasAsAulas } from '../lib/aulas';

const aulas = await todasAsAulas();
const materias = Array.from(new Map(aulas.map((aula) => [aula.data.materiaSlug, aula.data.materia])).entries()).map(([slug, nome]) => ({
  slug,
  nome,
  total: aulas.filter((aula) => aula.data.materiaSlug === slug).length,
}));
---
<BaseLayout title="Minhas disciplinas · Eclesiastes" wide>
  <section class="dashboard" aria-labelledby="minhas-disciplinas">
    <h1 id="minhas-disciplinas">Minhas disciplinas</h1>
    <div class="course-tabs" aria-label="Filtro de disciplinas">
      <span class="course-tabs__selected">★ Todos <b>{materias.length}</b></span>
    </div>
    <div class="subject-grid" aria-label="Disciplinas disponíveis">
      {materias.map((materia) => <article class="subject-card">
        <a class="subject-card__link" href={comBase(`/${materia.slug}`)}>
          <div class="subject-card__visual" aria-hidden="true"><span>★</span><strong>Acessar <b>→</b></strong></div>
          <div class="subject-card__body"><h2>{materia.nome}</h2><small>{materia.total} conteúdos</small></div>
        </a>
      </article>)}
    </div>
  </section>
</BaseLayout>
