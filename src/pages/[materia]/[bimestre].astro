---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import { comBase } from '../../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  const paths = new Set(aulas.map((aula) => `${aula.data.materiaSlug}/${aula.data.bimestre}`));
  return [...paths].map((path) => {
    const [materia, bimestre] = path.split('/');
    return { params: { materia, bimestre } };
  });
}

const destination = comBase(`/${Astro.params.materia}`);
---
<BaseLayout title="Eclesiastes">
  <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
  <section class="redirect-notice"><p>As semanas desta disciplina agora estão reunidas em uma única página.</p><a href={destination}>Continuar para a disciplina</a></section>
</BaseLayout>
