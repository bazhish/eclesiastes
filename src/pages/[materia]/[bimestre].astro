---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import WeekCheckpointList from '../../components/WeekCheckpointList.astro';
import { comBase, semanasPorBimestre } from '../../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  const paths = new Map<string, { materia: string; bimestre: string; nome: string; aulas: typeof aulas }>();
  for (const aula of aulas) paths.set(`${aula.data.materiaSlug}/${aula.data.bimestre}`, { materia: aula.data.materiaSlug, bimestre: String(aula.data.bimestre), nome: aula.data.materia, aulas });
  return Array.from(paths.values()).map(({ materia, bimestre, nome, aulas }) => ({ params: { materia, bimestre }, props: { materia, bimestre: Number(bimestre), nome, aulas } }));
}

const { materia, bimestre, nome, aulas } = Astro.props;
const grupos = semanasPorBimestre(aulas.filter((aula) => aula.data.materiaSlug === materia && aula.data.bimestre === bimestre));
---
<BaseLayout title={`${nome} · Bimestre ${bimestre} · Eclesiastes`} wide>
  <nav class="breadcrumbs" aria-label="Caminho da página"><ol><li><a href={import.meta.env.BASE_URL}>Início</a></li><li><a href={comBase(`/${materia}`)}>{nome}</a></li><li><span aria-current="page">{bimestre}º Bimestre</span></li></ol></nav>
  <p class="eyebrow">{nome}</p>
  <h1>{bimestre}º Bimestre</h1>
  <p class="lede">Semanas disponíveis para consulta e acompanhamento local.</p>
  <WeekCheckpointList materia={materia} grupos={grupos} />
</BaseLayout>
