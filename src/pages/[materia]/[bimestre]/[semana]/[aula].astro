---
import { getCollection } from 'astro:content';
import AtividadeCard from '../../../../components/AtividadeCard.astro';
import BaseLayout from '../../../../components/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import QuizBlock from '../../../../components/QuizBlock.astro';
import { rotaDaAula } from '../../../../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  return aulas.map((aula) => ({
    params: { materia: aula.data.materiaSlug, bimestre: String(aula.data.bimestre), semana: `semana-${aula.data.semana}`, aula: aula.data.aula },
    props: { aula },
  }));
}

const { aula } = Astro.props;
const currentPath = rotaDaAula(aula);
---
<BaseLayout title={`${aula.data.titulo} · Desenvolvimento de Sistemas`} currentPath={currentPath} showSidebar>
  <Breadcrumb aula={aula} />
  <header class="lesson-head">
    <p class="eyebrow">{aula.data.materia} · Semana {aula.data.semana}</p>
    <h1>{aula.data.titulo}</h1>
    <p class="meta">Aula {aula.data.aula.toUpperCase()} · 3º bimestre</p>
  </header>
  {aula.data.atividade && <AtividadeCard atividade={aula.data.atividade} id={aula.id.replaceAll('/', '-')} />}
  {aula.data.quizzes.map((quiz, index) => <QuizBlock quiz={quiz} index={`${aula.id}-${index}`} />)}
</BaseLayout>
