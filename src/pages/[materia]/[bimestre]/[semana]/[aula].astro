---
import { getCollection } from 'astro:content';
import AtividadeCard from '../../../../components/AtividadeCard.astro';
import BaseLayout from '../../../../components/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import QuizBlock from '../../../../components/QuizBlock.astro';
import { rotaDaAula } from '../../../../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  return aulas.map((aula) => ({ params: { materia: aula.data.materiaSlug, bimestre: String(aula.data.bimestre), semana: `semana-${aula.data.semana}`, aula: aula.data.aula }, props: { aula } }));
}

const { aula } = Astro.props;
const currentPath = rotaDaAula(aula);
const resourceName = aula.data.tipo === 'pausa' ? 'Pause e Responda' : aula.data.tipo === 'registro' ? 'Registro da Aula' : 'Material da Aula';
---
<BaseLayout title={`${aula.data.titulo} · Eclesiastes`} currentPath={currentPath} showSidebar>
  <section class="course-page resource-page">
    <Breadcrumb aula={aula} />
    <header class="resource-page__head"><p>{resourceName}</p><h1>{aula.data.titulo}</h1></header>
    {aula.data.atividade && <AtividadeCard atividade={aula.data.atividade} id={aula.id.replaceAll('/', '-')} />}
    {aula.data.quizzes.map((quiz, index) => <QuizBlock quiz={quiz} index={`${aula.id}-${index}`} />)}
    <a class="back-to-week" href={`../`}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar à semana</a>
  </section>
</BaseLayout>
