---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import ContentTypeIcon from '../../../components/ContentTypeIcon.astro';
import { comBase, rotaDaAula } from '../../../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  const paths = new Map<string, { materia: string; bimestre: string; semana: string; nome: string; aulas: typeof aulas }>();
  for (const aula of aulas) paths.set(`${aula.data.materiaSlug}/${aula.data.bimestre}/semana-${aula.data.semana}`, { materia: aula.data.materiaSlug, bimestre: String(aula.data.bimestre), semana: `semana-${aula.data.semana}`, nome: aula.data.materia, aulas });
  return Array.from(paths.values()).map(({ materia, bimestre, semana, nome, aulas }) => ({ params: { materia, bimestre, semana }, props: { materia, bimestre: Number(bimestre), semana: Number(semana.replace('semana-', '')), nome, aulas } }));
}

const { materia, bimestre, semana, nome, aulas } = Astro.props;
const currentPath = `/${materia}/${bimestre}/semana-${semana}`;
const itens = aulas.filter((aula) => aula.data.materiaSlug === materia && aula.data.bimestre === bimestre && aula.data.semana === semana).sort((a, b) => a.data.ordem - b.data.ordem);
---
<BaseLayout title={`${nome} · Semana ${semana} · Eclesiastes`} currentPath={currentPath} showSidebar>
  <section class="course-page">
    <nav class="breadcrumbs" aria-label="Trilha de navegação"><a href={comBase('/')}>Página inicial</a><span>/</span><a href={comBase(`/${materia}/${bimestre}`)}>{nome} – {bimestre}º Bimestre</a><span>/</span><span aria-current="page">Semana {semana} (S{semana})</span></nav>
    <h1>Semana {semana} (S{semana})</h1>
    <p class="week-introduction">A resposta ainda não foi divulgada.</p>
    <section class="lesson-accordions" aria-label={`Aulas da semana ${semana}`}>
      {itens.map((aula) => <details class="lesson-accordion" open>
        <summary><span class="lesson-accordion__chevron" aria-hidden="true">⌄</span><strong>{aula.data.titulo}</strong></summary>
        <a class="learning-resource" href={comBase(rotaDaAula(aula))}><ContentTypeIcon tipo={aula.data.tipo} label={false} /><span>{aula.data.tipo === 'pausa' ? 'Pause e Responda' : aula.data.tipo === 'registro' ? 'Registro da Aula' : 'Material da Aula'} (S{semana}{aula.data.aula.toUpperCase()})</span><span class="resource-state">Acessar <b>›</b></span></a>
      </details>)}
    </section>
  </section>
</BaseLayout>
