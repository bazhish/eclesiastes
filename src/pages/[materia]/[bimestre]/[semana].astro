---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import ContentTypeIcon from '../../../components/ContentTypeIcon.astro';
import { comBase, rotaDaAula } from '../../../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  const paths = new Map<string, { materia: string; bimestre: string; semana: string; nome: string; aulas: typeof aulas }>();
  for (const aula of aulas) paths.set(`${aula.data.materiaSlug}/${aula.data.bimestre}/semana-${aula.data.semana}`, { materia: aula.data.materiaSlug, bimestre: String(aula.data.bimestre), semana: `semana-${aula.data.semana}`, nome: aula.data.materia, aulas });
  return Array.from(paths.values()).map(({ materia, bimestre, semana, nome, aulas }) => ({ params: { materia, bimestre, semana }, props: { materia, bimestre: Number(bimestre), semana: Number(semana.replace('semana-', '')), nome, aulas } }));
}

const { materia, bimestre, semana, nome, aulas } = Astro.props;
const currentPath = `/${materia}/${bimestre}/semana-${semana}`;
const itens = aulas.filter((aula) => aula.data.materiaSlug === materia && aula.data.bimestre === bimestre && aula.data.semana === semana).sort((a, b) => a.data.ordem - b.data.ordem);
---
<BaseLayout title={`${nome} · Semana ${semana} · Eclesiastes`} currentPath={currentPath} showSidebar>
  <nav class="breadcrumbs" aria-label="Caminho da página"><ol><li><a href={import.meta.env.BASE_URL}>Início</a></li><li><a href={comBase(`/${materia}`)}>{nome}</a></li><li><a href={comBase(`/${materia}/${bimestre}`)}>Bimestre {bimestre}</a></li><li><span aria-current="page">Semana {semana}</span></li></ol></nav>
  <p class="eyebrow">{nome} · Bimestre {bimestre}</p>
  <h1>Semana {semana}</h1>
  <p class="lede">Escolha uma aula. A navegação lateral mantém as semanas desta matéria acessíveis durante a consulta.</p>
  <section class="lesson-list" data-scroll-spy aria-label={`Aulas da semana ${semana}`}>
    {itens.map((aula) => <article class="lesson-list__item" id={`secao-${aula.data.aula}`} data-scroll-section={aula.data.aula} data-scroll-route={rotaDaAula(aula)}>
      <a href={comBase(rotaDaAula(aula))}><span class="lesson-list__badge"><ContentTypeIcon tipo={aula.data.tipo} label={false} />{aula.data.aula.toUpperCase()}</span><div><strong>{aula.data.titulo}</strong><small>{aula.data.atividade ? 'Roteiro prático' : `${aula.data.quizzes.length} questões de revisão`}</small></div><span class="lesson-list__arrow" aria-hidden="true">→</span></a>
    </article>)}
  </section>
</BaseLayout>
<script>
  const sections = [...document.querySelectorAll<HTMLElement>('[data-scroll-section]')];
  const routeLinks = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-sidebar-route]')].map((link) => [link.dataset.sidebarRoute, link]));
  let pending: HTMLElement | undefined;
  let frame = 0;
  const highlight = () => {
    frame = 0;
    if (!pending) return;
    document.querySelectorAll('[data-scroll-active]').forEach((link) => link.removeAttribute('data-scroll-active'));
    routeLinks.get(pending.dataset.scrollRoute ?? '')?.setAttribute('data-scroll-active', 'true');
  };
  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
    if (visible[0]) {
      pending = visible[0].target as HTMLElement;
      if (!frame) frame = requestAnimationFrame(highlight);
    }
  }, { rootMargin: '-18% 0px -64% 0px', threshold: [0, .01] });
  sections.forEach((section) => observer.observe(section));
</script>
