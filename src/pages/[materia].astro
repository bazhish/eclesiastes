---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import WeekCheckpointList from '../components/WeekCheckpointList.astro';
import { semanasPorBimestre } from '../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  const materias = new Map(aulas.map((aula) => [aula.data.materiaSlug, aula.data.materia]));
  return Array.from(materias.entries()).map(([materia, nome]) => ({ params: { materia }, props: { materia, nome, aulas } }));
}

const { materia, nome, aulas } = Astro.props;
const grupos = semanasPorBimestre(aulas.filter((aula) => aula.data.materiaSlug === materia));
---
<BaseLayout title={`${nome} · Eclesiastes`} wide>
  <nav class="breadcrumbs" aria-label="Caminho da página"><ol><li><a href={import.meta.env.BASE_URL}>Início</a></li><li><span aria-current="page">{nome}</span></li></ol></nav>
  <p class="eyebrow">Matéria</p>
  <h1>{nome}</h1>
  <p class="lede">Escolha uma semana para consultar as aulas e acompanhar seu progresso local.</p>
  <WeekCheckpointList materia={materia} grupos={grupos} />
</BaseLayout>
