---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import { comBase, semanasPorBimestre } from '../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('aulas');
  const materias = new Map(aulas.map((aula) => [aula.data.materiaSlug, aula.data.materia]));
  return Array.from(materias.entries()).map(([materia, nome]) => ({ params: { materia }, props: { materia, nome, aulas } }));
}

const { materia, nome, aulas } = Astro.props;
const grupos = semanasPorBimestre(aulas.filter((aula) => aula.data.materiaSlug === materia));
---
<BaseLayout title={`${nome} · Eclesiastes`} wide>
  <section class="discipline-hero"><div class="container"><nav class="breadcrumbs" aria-label="Trilha de navegação"><a href={comBase('/')}>Página inicial</a><span>/</span><span aria-current="page">{nome}</span></nav><h1>{nome}</h1></div></section>
  <section class="discipline-content container" aria-label="Bimestres">
    <h2>Selecione um bimestre</h2>
    <div class="bimestre-grid">
      {grupos.map((grupo) => <a class="bimestre-card" href={comBase(`/${materia}/${grupo.bimestre}`)}><h3>{nome} – {grupo.bimestre}º Bimestre</h3><span>{grupo.semanas.length} semanas <b>→</b></span></a>)}
    </div>
  </section>
</BaseLayout>
